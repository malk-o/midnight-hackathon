pragma language_version 0.23;

enum Category { travel, food, software, other }

witness reputationScore(): Uint<32>;

export ledger lastApproved: Boolean;
export ledger lastCategory: Category;
export ledger lastAmount: Uint<32>;
export ledger lastTier: Uint<8>;
export ledger reputationByUser: Map<Bytes<32>, Uint<32>>;

circuit categoryLimit(category: Category, tier: Uint<8>): Uint<32> {
  if (tier == 1) {
    if (category == Category.travel) { return 100; }
    if (category == Category.food) { return 30; }
    if (category == Category.software) { return 50; }
    return 50;
  }
  if (tier == 2) {
    if (category == Category.travel) { return 500; }
    if (category == Category.food) { return 100; }
    if (category == Category.software) { return 300; }
    return 200;
  }
  if (category == Category.travel) { return 2000; }
  if (category == Category.food) { return 300; }
  if (category == Category.software) { return 1000; }
  return 500;
}

circuit tierThreshold(tier: Uint<8>): Uint<32> {
  if (tier == 1) { return 0; }
  if (tier == 2) { return 50; }
  return 200;
}

export circuit checkGuardrails(category: Category, amount: Uint<32>, tier: Uint<8>): Boolean {
  const limit = categoryLimit(category, tier);
  const withinPolicy = amount <= limit;

  const rep = reputationScore();
  const threshold = tierThreshold(tier);
  const reputationOk = rep >= threshold;

  const approved = withinPolicy && reputationOk;

  const approvedDisclosed = disclose(approved);

  lastApproved = approvedDisclosed;
  lastCategory = disclose(category);
  lastAmount = disclose(amount);
  lastTier = disclose(tier);

  return approvedDisclosed;
}

export circuit recordApprovedAction(userId: Bytes<32>, category: Category, amount: Uint<32>): [] {
  const current = reputationByUser.member(userId) ? reputationByUser.lookup(userId) : 0;
  const bump = 5; // flat increment per approved action for now — keep it simple
  reputationByUser.insert(userId, current + bump);
}
